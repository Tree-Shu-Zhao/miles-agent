diff --git a/tests/fast/backends/training_utils/loss/test_fp32_lm_head.py b/tests/fast/backends/training_utils/loss/test_fp32_lm_head.py
new file mode 100644
index 000000000..dbec9ba16
--- /dev/null
+++ b/tests/fast/backends/training_utils/loss/test_fp32_lm_head.py
@@ -0,0 +1,106 @@
+"""--fp32-lm-head: the chunked log-probs, entropy and gradients equal plain fp32 autograd on the full logits."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from miles.backends.training_utils.loss.hub import fp32_lm_head
+
+# This module intentionally has no explicit CI registration call: modules under
+# tests/fast are implicitly assigned to the stage-a-cpu suite by the CI collector.
+
+
+def _reference(hidden, weight, tokens, temperature):
+    logits = hidden.float() @ weight.float().t() / temperature
+    log_p = torch.log_softmax(logits, dim=-1)
+    entropy = -(log_p.exp() * log_p).sum(dim=-1)
+    return log_p.gather(1, tokens[:, None]).squeeze(1), entropy
+
+
+@pytest.mark.parametrize("chunk_size", [1, 5, 7, 64])
+@pytest.mark.parametrize("temperature", [1.0, 0.7])
+def test_matches_fp32_autograd(chunk_size, temperature):
+    torch.manual_seed(0)
+    n, h, v = 23, 16, 97
+    hidden = (torch.randn(n, h) * 2).to(torch.bfloat16).requires_grad_()
+    weight = (torch.randn(v, h) * 2).to(torch.bfloat16).requires_grad_()
+    tokens = torch.randint(0, v, (n,))
+    upstream = torch.randn(n)
+
+    log_p, entropy = fp32_lm_head.log_probs_and_entropy(
+        hidden, weight, tokens, chunk_size=chunk_size, temperature=temperature, with_entropy=True
+    )
+    (log_p * upstream).sum().backward()
+
+    hidden_ref = hidden.detach().float().requires_grad_()
+    weight_ref = weight.detach().float().requires_grad_()
+    log_p_ref, entropy_ref = _reference(hidden_ref, weight_ref, tokens, temperature)
+    (log_p_ref * upstream).sum().backward()
+
+    assert log_p.dtype == torch.float32
+    torch.testing.assert_close(log_p, log_p_ref, rtol=1e-5, atol=1e-5)
+    torch.testing.assert_close(entropy, entropy_ref.detach(), rtol=1e-5, atol=1e-5)
+    assert not entropy.requires_grad
+    # the gradients come back in the parameters' bf16
+    torch.testing.assert_close(hidden.grad.float(), hidden_ref.grad, rtol=2e-2, atol=2e-2)
+    torch.testing.assert_close(weight.grad.float(), weight_ref.grad, rtol=2e-2, atol=2e-2)
+
+
+def test_entropy_off_and_empty_response():
+    weight = torch.randn(11, 4).to(torch.bfloat16).requires_grad_()
+    hidden = torch.randn(0, 4).to(torch.bfloat16).requires_grad_()
+    log_p, entropy = fp32_lm_head.log_probs_and_entropy(
+        hidden, weight, torch.zeros(0, dtype=torch.long), chunk_size=4, temperature=1.0, with_entropy=False
+    )
+    assert log_p.shape == (0,) and entropy is None
+    log_p.sum().backward()
+    assert weight.grad is not None and torch.count_nonzero(weight.grad) == 0
+
+
+def _args(**overrides):
+    # as miles_validate_args sees them: before use_sampling_support_replay is derived
+    values = dict(
+        train_backend="megatron",
+        tensor_model_parallel_size=1,
+        context_parallel_size=1,
+        true_on_policy_mode=False,
+        rollout_top_p=1.0,
+        rollout_top_k=-1,
+        entropy_coef=0.0,
+    )
+    return SimpleNamespace(**(values | overrides))
+
+
+def test_validate_args_reads_the_sampling_flags_not_the_derived_replay_flag():
+    fp32_lm_head.validate_fp32_lm_head_args(_args())
+    for bad in (
+        dict(rollout_top_p=0.95, rollout_top_k=20),
+        dict(rollout_top_k=20),
+        dict(tensor_model_parallel_size=2),
+        dict(true_on_policy_mode=True),
+        dict(entropy_coef=0.01),
+        dict(train_backend="fsdp"),
+    ):
+        with pytest.raises(AssertionError):
+            fp32_lm_head.validate_fp32_lm_head_args(_args(**bad))
+
+
+def test_output_processor_returns_hidden_states_and_stashes_the_weight():
+    hidden = torch.randn(5, 1, 4)  # [s, b, h]
+    shared = torch.randn(9, 4)
+
+    class _Layer:
+        weight = torch.randn(9, 4)
+        sequence_parallel = False
+
+    class _Config:
+        use_mup = False
+
+    out = fp32_lm_head.output_processor(
+        hidden_states=hidden, output_layer=_Layer(), output_weight=shared, config=_Config(), labels=None
+    )
+    assert out.shape == (1, 5, 4)
+    assert fp32_lm_head.take_output_weight() is shared
+    fp32_lm_head.output_processor(hidden_states=hidden, output_layer=_Layer(), output_weight=None, config=_Config())
+    assert fp32_lm_head.take_output_weight() is _Layer.weight
