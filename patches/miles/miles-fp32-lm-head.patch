new file mode 100644
index 000000000..329087b23
--- /dev/null
+++ b/miles/backends/training_utils/loss/hub/fp32_lm_head.py
@@ -0,0 +1,153 @@
+"""Trainer-side FP32 LM head (``--fp32-lm-head``).
+
+``--sglang-enable-fp32-lm-head`` makes the engines sample from fp32 logits, while Megatron's output layer rounds the
+trainer's logits to bf16 (a spacing of 0.125 for logits in [16, 32)), so the trainer scores a different distribution
+than the one sampled. With this flag the model stops before its output layer (Megatron's ``output_processor`` hook
+hands back the final hidden states) and the log-probs are computed here, one chunk of tokens at a time: the chunk's
+logits in fp32 (bf16 hidden states x bf16 output weight, fp32 accumulation and output, which is what an fp32 head
+computes from bf16 activations and weights), their logsumexp, the sampled tokens' log-probs and, detached, the
+entropy. The backward recomputes each chunk's logits and runs its matmuls in fp32 storage with TF32 math, so no
+``[tokens, vocab]`` tensor of the whole micro-batch ever exists (fp32 logits of a 69,632-token micro-batch over
+Qwen3.5's 248,320-token vocabulary would be 69 GB, and their gradient as much again).
+
+Tensor and context parallelism stay at 1: the weight is the whole vocabulary and the hidden states the whole
+sequence.
+"""
+
+from contextlib import contextmanager
+
+import torch
+
+_STASH: dict[str, torch.Tensor] = {}
+
+
+def validate_fp32_lm_head_args(args) -> None:
+    """What --fp32-lm-head needs (miles_validate_args). The sampling-support check reads the flags themselves:
+    ``use_sampling_support_replay`` is derived from them later in miles_validate_args."""
+    assert args.train_backend == "megatron", "--fp32-lm-head is implemented for the Megatron backend"
+    assert getattr(args, "tensor_model_parallel_size", 1) == 1, "--fp32-lm-head needs TP 1"
+    assert getattr(args, "context_parallel_size", 1) == 1, "--fp32-lm-head needs CP 1"
+    assert not args.true_on_policy_mode, "--fp32-lm-head and --true-on-policy-mode both own the log-probs"
+    assert (
+        args.rollout_top_p >= 1.0 and args.rollout_top_k <= 0
+    ), "--fp32-lm-head does not apply the sampling-support masks of --rollout-top-p / --rollout-top-k"
+    assert args.entropy_coef == 0, "--fp32-lm-head computes the entropy detached: --entropy-coef must be 0"
+
+
+def output_processor(*, hidden_states: torch.Tensor, output_layer, output_weight, config, **_) -> torch.Tensor:
+    """Megatron ``GPTModel`` output hook: the final hidden states as ``[b, s, h]`` (the layout logits would have) in
+    place of the logits; the output weight (the tied embedding's when shared) goes to ``_STASH`` for the loss of the
+    same micro-batch."""
+    if getattr(config, "use_mup", False):
+        raise NotImplementedError("--fp32-lm-head does not apply MuP's logit scaling")
+    if getattr(output_layer, "sequence_parallel", False):
+        raise NotImplementedError("--fp32-lm-head needs the whole sequence on the rank (no sequence parallelism)")
+    _STASH["weight"] = output_weight if output_weight is not None else output_layer.weight
+    return hidden_states.transpose(0, 1)
+
+
+def take_output_weight() -> torch.Tensor:
+    weight = _STASH.get("weight")
+    if weight is None:
+        raise RuntimeError("--fp32-lm-head: no output weight from the model's forward (output_processor not passed?)")
+    return weight
+
+
+@contextmanager
+def _tf32_matmuls():
+    previous = torch.backends.cuda.matmul.allow_tf32
+    torch.backends.cuda.matmul.allow_tf32 = True
+    try:
+        yield
+    finally:
+        torch.backends.cuda.matmul.allow_tf32 = previous
+
+
+def _chunk_logits(hidden: torch.Tensor, weight: torch.Tensor, temperature: float) -> torch.Tensor:
+    if hidden.is_cuda and torch.version.hip is None:
+        logits = torch.mm(hidden, weight.t(), out_dtype=torch.float32)
+    else:  # no bf16-in/fp32-out mm (CPU, ROCm): the same products and fp32 sums from upcast inputs
+        logits = torch.mm(hidden.float(), weight.float().t())
+    if temperature != 1.0:
+        logits.div_(temperature)
+    return logits
+
+
+class _FP32HeadLogProbs(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, hidden, weight, tokens, chunk_size: int, temperature: float, with_entropy: bool):
+        n = hidden.size(0)
+        log_probs = hidden.new_empty(n, dtype=torch.float32)
+        lse = hidden.new_empty(n, dtype=torch.float32)
+        entropy = hidden.new_empty(n if with_entropy else 0, dtype=torch.float32)
+        for s in range(0, n, chunk_size):
+            e = min(s + chunk_size, n)
+            logits = _chunk_logits(hidden[s:e], weight, temperature)
+            lse_c = torch.logsumexp(logits, dim=-1)
+            lse[s:e] = lse_c
+            log_probs[s:e] = logits.gather(1, tokens[s:e, None]).squeeze(1) - lse_c
+            if with_entropy:
+                logits.sub_(lse_c[:, None])  # log p
+                p_log_p = logits.exp().mul_(logits)
+                entropy[s:e] = -p_log_p.sum(dim=-1)
+                del p_log_p
+            del logits
+        ctx.save_for_backward(hidden, weight, tokens, lse)
+        ctx.chunk_size = chunk_size
+        ctx.temperature = temperature
+        ctx.mark_non_differentiable(entropy)
+        return log_probs, entropy
+
+    @staticmethod
+    def backward(ctx, grad_log_probs, _grad_entropy):
+        hidden, weight, tokens, lse = ctx.saved_tensors
+        n = hidden.size(0)
+        need_hidden, need_weight = ctx.needs_input_grad[0], ctx.needs_input_grad[1]
+        grad_hidden = torch.empty_like(hidden) if need_hidden else None
+        grad_weight = torch.zeros(weight.shape, dtype=torch.float32, device=weight.device) if need_weight else None
+        if grad_log_probs is None or n == 0:
+            return (
+                torch.zeros_like(hidden) if need_hidden else None,
+                grad_weight.to(weight.dtype) if need_weight else None,
+                None,
+                None,
+                None,
+                None,
+            )
+        grad_log_probs = grad_log_probs.float()
+        weight_fp32 = weight.float()
+        with _tf32_matmuls():
+            for s in range(0, n, ctx.chunk_size):
+                e = min(s + ctx.chunk_size, n)
+                g = _chunk_logits(hidden[s:e], weight, ctx.temperature)
+                # d log p(y) / d logits = onehot(y) - softmax, times the incoming gradient
+                g.sub_(lse[s:e, None]).exp_().mul_(-grad_log_probs[s:e, None])
+                g.scatter_add_(1, tokens[s:e, None], grad_log_probs[s:e, None])
+                if ctx.temperature != 1.0:
+                    g.div_(ctx.temperature)
+                if need_hidden:
+                    grad_hidden[s:e] = torch.mm(g, weight_fp32).to(hidden.dtype)
+                if need_weight:
+                    grad_weight.addmm_(g.t(), hidden[s:e].float())
+                del g
+        return grad_hidden, grad_weight.to(weight.dtype) if need_weight else None, None, None, None, None
+
+
+def log_probs_and_entropy(
+    hidden: torch.Tensor,
+    weight: torch.Tensor,
+    tokens: torch.Tensor,
+    *,
+    chunk_size: int,
+    temperature: float,
+    with_entropy: bool,
+) -> tuple[torch.Tensor, torch.Tensor | None]:
+    """Per-token ``log p(token)`` (``[R]``, fp32, differentiable in ``hidden`` and ``weight``) and, when asked, the
+    detached entropy, from a sample's response hidden states ``[R, h]`` and the output weight ``[V, h]``."""
+    if chunk_size <= 0:
+        chunk_size = 4096
+    hidden = hidden.to(weight.dtype)
+    log_probs, entropy = _FP32HeadLogProbs.apply(
+        hidden, weight, tokens.long(), chunk_size, float(temperature), with_entropy
+    )
+    return log_probs, (entropy if with_entropy else None)
