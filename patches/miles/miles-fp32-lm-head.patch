+def _fp32_head_log_probs_and_entropy(
+    hidden_states: torch.Tensor,
+    *,
+    args: Namespace,
+    unconcat_tokens: list[torch.Tensor],
+    total_lengths: list[int],
+    response_lengths: list[int],
+    max_seq_lens: list[int] | None,
+    with_entropy: bool,
+    entropy_requires_grad: bool,
+) -> dict[str, list[torch.Tensor]]:
+    """``get_log_probs_and_entropy`` under --fp32-lm-head: the model returned its final hidden states ``[1, T, h]``
+    in place of the logits (fp32_lm_head.output_processor); each response's log-probs come from fp32 logits computed
+    a --log-probs-chunk-size chunk at a time (fp32_lm_head)."""
+    if with_entropy and entropy_requires_grad:
+        raise NotImplementedError("--fp32-lm-head computes the entropy detached: --entropy-coef must be 0")
+    weight = fp32_lm_head.take_output_weight()
+    log_probs_list = []
+    entropy_list = []
+    for hidden_chunk, tokens_chunk, _ in _iter_response_chunks(
+        hidden_states,
+        args=args,
+        unconcat_tokens=unconcat_tokens,
+        total_lengths=total_lengths,
+        response_lengths=response_lengths,
+        max_seq_lens=max_seq_lens,
+        include_response_indices=False,
+    ):
+        log_prob, entropy = fp32_lm_head.log_probs_and_entropy(
+            hidden_chunk,
+            weight,
+            tokens_chunk,
+            chunk_size=args.log_probs_chunk_size,
+            temperature=args.rollout_temperature,
+            with_entropy=with_entropy,
+        )
+        log_probs_list.append(log_prob)
+        if with_entropy:
+            entropy_list.append(entropy)
+    res = {"log_probs": log_probs_list}
+    if with_entropy:
+        res["entropy"] = entropy_list
+    return res
+
+
 def get_values(
     logits: torch.Tensor,
     *,
