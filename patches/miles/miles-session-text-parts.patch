diff --git a/miles/rollout/session/request_args.py b/miles/rollout/session/request_args.py
index d742dbca5..ddd150046 100644
--- a/miles/rollout/session/request_args.py
+++ b/miles/rollout/session/request_args.py
@@ -129,6 +129,30 @@ def apply_session_sampling_defaults(
             )
 
 
+def _flatten_text_parts(message: Any) -> Any:
+    """A content-part list of text only (the OpenAI list form, which e.g. OpenHands
+    sends) becomes the string SGLang renders from it (space-joined, as in
+    ``process_content_for_template_format``). The TITO templates read string content
+    only (qwen3_fixed.jinja renders anything else as ''), and stored history is
+    matched against string content. Other messages pass through unchanged."""
+    content = message.get("content") if isinstance(message, dict) else None
+    if not isinstance(content, list) or not content:
+        return message
+    if not all(isinstance(p, dict) and p.get("type") == "text" and isinstance(p.get("text"), str) for p in content):
+        return message
+    return {**message, "content": " ".join(p["text"] for p in content)}
+
+
+def flatten_text_part_messages(messages: Any) -> Any:
+    """``_flatten_text_parts`` over a messages list; anything else passes through for
+    validation to report. The session matches history and renders input_ids from this
+    form too, not from the client's part lists: Qwen3's template concatenates a system
+    message's content as a string, so a part list there fails the render outright."""
+    if not isinstance(messages, list):
+        return messages
+    return [_flatten_text_parts(message) for message in messages]
+
+
 def resolve_request_args_by_config(
     request_args: dict[str, Any], config: SessionServerConfig, *, evaluation: bool = False
 ) -> tuple[dict[str, Any], ClientResponseIntent]:
@@ -185,6 +209,8 @@ def resolve_request_args_by_config(
     # streaming intent for the response, but keep the backend request non-streaming.
     client_stream = bool(request_args.pop("stream", False))
     request_args.pop("stream_options", None)
+    if isinstance(request_args.get("messages"), list):
+        request_args["messages"] = flatten_text_part_messages(request_args["messages"])
     kwargs = request_args.get("chat_template_kwargs")
     if kwargs is not None and not isinstance(kwargs, dict):
         raise MessageValidationError("chat_template_kwargs must be an object")
