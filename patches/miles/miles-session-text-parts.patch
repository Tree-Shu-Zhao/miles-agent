+@pytest.mark.parametrize("version", [V1, V2])
+def test_text_part_content_renders_as_sglang_string(version):
+    """OpenAI text-part lists (ProRL's OpenHands fork sends them) reach the TITO render,
+    not just the forwarded body, as SGLang's space-joined string. Qwen3's template
+    cannot concatenate a list-form system message at all, and renders other list
+    content as ''. A list-form replay continues the stored string history."""
+
+    def parts(*texts: str) -> list[dict]:
+        return [{"type": "text", "text": text} for text in texts]
+
+    def answer(_prompt: str) -> ProcessResult:
+        return ProcessResult(text="It is 4.", finish_reason="stop")
+
+    with with_mock_server(model_name=_MODEL, process_fn=answer) as backend:
+        with _serve_session(backend_url=backend.url, hf_checkpoint=_MODEL, version=version) as args:
+            session_url = args.session_server_instances[0].url
+            session_id = requests.post(f"{session_url}/sessions", timeout=5.0).json()["session_id"]
+            chat_url = f"{session_url}/sessions/{session_id}/v1/chat/completions"
+            messages = [
+                {"role": "system", "content": parts("Answer briefly.")},
+                {"role": "user", "content": parts("What is", "2+2?")},
+            ]
+
+            first = requests.post(chat_url, json={"messages": messages}, timeout=10.0)
+            assert first.status_code == 200, first.text
+            prompt = backend.tokenizer.decode(backend.request_log[-1]["input_ids"])
+            assert "Answer briefly." in prompt and "What is 2+2?" in prompt
+            assert backend.request_log[-1]["messages"][1]["content"] == "What is 2+2?"
+
+            followup = [*messages, first.json()["choices"][0]["message"], {"role": "user", "content": parts("And 3+3?")}]
+            second = requests.post(chat_url, json={"messages": followup}, timeout=10.0)
+            assert second.status_code == 200, second.text
+            prompt = backend.tokenizer.decode(backend.request_log[-1]["input_ids"])
+            assert "What is 2+2?" in prompt and "It is 4." in prompt and "And 3+3?" in prompt
+
+
