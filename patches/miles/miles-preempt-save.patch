diff --git a/miles/utils/preempt.py b/miles/utils/preempt.py
new file mode 100644
index 000000000..c29c25524
--- /dev/null
+++ b/miles/utils/preempt.py
@@ -0,0 +1,79 @@
+"""--preempt-sentinel: leave a run resumable when its job is about to be killed.
+
+A job script turns the scheduler's warning (Slurm signals it at preemption, and
+``--signal``'s lead before the time limit) into the sentinel file. The drivers
+then stop at the earliest safe point: an in-flight rollout or eval is abandoned
+and never trained on, the latest trained state is saved unless it is already on
+disk, and ``<sentinel>.done`` records the rollout id the run is durable up to,
+which tells the job script it may requeue or exit.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import os
+from collections.abc import Awaitable
+from typing import TypeVar
+
+logger = logging.getLogger(__name__)
+
+_T = TypeVar("_T")
+
+POLL_SECONDS = 2.0
+
+
+class PreemptWatch:
+    def __init__(self, sentinel: str | None) -> None:
+        self.sentinel = sentinel
+        self._fired = asyncio.Event()
+        self._poller = asyncio.create_task(self._poll()) if sentinel is not None else None
+
+    async def _poll(self) -> None:
+        while not os.path.exists(self.sentinel):
+            await asyncio.sleep(POLL_SECONDS)
+        logger.warning(f"Preempt sentinel {self.sentinel} appeared: saving the latest trained state and stopping")
+        self._fired.set()
+
+    @property
+    def fired(self) -> bool:
+        return self._fired.is_set()
+
+    async def race(self, awaitable: Awaitable[_T]) -> tuple[bool, _T | None]:
+        """Await ``awaitable`` unless the sentinel appears first.
+
+        Returns ``(True, result)``, or ``(False, None)`` with the awaitable cancelled; the
+        caller then stops whatever it had started remotely.
+        """
+        if self._poller is None:
+            return True, await awaitable
+        task = asyncio.ensure_future(awaitable)
+        fired = asyncio.ensure_future(self._fired.wait())
+        try:
+            await asyncio.wait({task, fired}, return_when=asyncio.FIRST_COMPLETED)
+        finally:
+            fired.cancel()
+        if task.done():
+            return True, task.result()
+        task.cancel()
+        task.add_done_callback(_retrieve)
+        return False, None
+
+    def mark_done(self, rollout_id: int) -> None:
+        """Record that the run is durable up to ``rollout_id`` (-1: nothing trained yet)."""
+        path = f"{self.sentinel}.done"
+        with open(f"{path}.tmp", "w") as f:
+            json.dump({"rollout_id": rollout_id}, f)
+        os.replace(f"{path}.tmp", path)
+        logger.warning(f"Preempt: the run is durable up to rollout {rollout_id}, stopping")
+
+    def dispose(self) -> None:
+        if self._poller is not None:
+            self._poller.cancel()
+
+
+def _retrieve(task: asyncio.Future) -> None:
+    # an abandoned call may still fail; its error is expected and must not be logged as unretrieved
+    if not task.cancelled():
+        task.exception()
