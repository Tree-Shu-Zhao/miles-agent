--- /dev/null
+++ b/tests/fast/utils/test_preempt.py
@@ -0,0 +1,72 @@
+import asyncio
+import json
+
+import pytest
+
+from miles.utils import preempt as preempt_utils
+from miles.utils.preempt import PreemptWatch
+
+
+@pytest.fixture(autouse=True)
+def _fast_poll(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(preempt_utils, "POLL_SECONDS", 0.01)
+
+
+class TestRace:
+    async def test_the_awaitable_wins_while_no_sentinel_appears(self, tmp_path) -> None:
+        watch = PreemptWatch(str(tmp_path / "preempt"))
+        try:
+            assert await watch.race(asyncio.sleep(0, result="data")) == (True, "data")
+            assert not watch.fired
+        finally:
+            watch.dispose()
+
+    async def test_a_sentinel_cancels_the_awaitable(self, tmp_path) -> None:
+        sentinel = tmp_path / "preempt"
+        watch = PreemptWatch(str(sentinel))
+        cancelled = asyncio.Event()
+
+        async def endless() -> None:
+            try:
+                await asyncio.Event().wait()
+            except asyncio.CancelledError:
+                cancelled.set()
+                raise
+
+        async def raise_sentinel() -> None:
+            await asyncio.sleep(0.05)
+            sentinel.touch()
+
+        raiser = asyncio.ensure_future(raise_sentinel())
+        try:
+            assert await watch.race(endless()) == (False, None)
+            await asyncio.wait_for(cancelled.wait(), timeout=1)
+            assert watch.fired
+        finally:
+            await raiser
+            watch.dispose()
+
+    async def test_a_sentinel_present_at_start_fires_at_once(self, tmp_path) -> None:
+        """A signal that arrives while the run still starts up stops it at its first wait."""
+        sentinel = tmp_path / "preempt"
+        sentinel.touch()
+        watch = PreemptWatch(str(sentinel))
+        try:
+            assert await watch.race(asyncio.Event().wait()) == (False, None)
+        finally:
+            watch.dispose()
+
+    async def test_without_a_sentinel_race_is_a_plain_await(self) -> None:
+        watch = PreemptWatch(None)
+        assert await watch.race(asyncio.sleep(0, result=7)) == (True, 7)
+        assert not watch.fired
+        watch.dispose()
+
+
+class TestMarkDone:
+    async def test_mark_done_records_the_durable_rollout(self, tmp_path) -> None:
+        watch = PreemptWatch(str(tmp_path / "preempt"))
+        watch.mark_done(5)
+        watch.dispose()
+        assert json.loads((tmp_path / "preempt.done").read_text()) == {"rollout_id": 5}
+        assert not (tmp_path / "preempt.done.tmp").exists()
