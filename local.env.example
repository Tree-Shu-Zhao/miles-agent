# local.env.example — copy to local.env (git-ignored) and uncomment the lines you change.
#
# scripts/lib/common.sh reads local.env line by line: only KEY=value lines count (no shell syntax is run),
# $REPO (this checkout) and $HOME are expanded as whole words ($REPOSITORY stays as it is), the value is what
# stands between its quotes or ends at a trailing ` # note` (so the notes below may stay on the line), the last
# line of a key wins, and a variable that is already set in your environment is never overridden (an `export
# FOO=...` in your shell wins over this file). LOCAL_ENV=<file> points the scripts at another file,
# LOCAL_ENV=/dev/null at none (what a job wrapper exports). Every value below is the default of a plain machine
# (everything hangs under the repo), except the run-level knobs at the end: those have no default, and RECIPE and
# RUN_TAG are required.
#
# ---- roots -------------------------------------------------------------------------------------------------
#MILES_AGENT_MODELS=$REPO/models            # HF model dirs; the policy is $MILES_AGENT_MODELS/$POLICY_MODEL
#MILES_AGENT_DATA=$REPO/data                # per-environment data (scripts/fetch_data.sh) and the per-run rows
#MILES_AGENT_RESULTS=$REPO/results          # checkpoints, logs and the stop sentinel: $MILES_AGENT_RESULTS/<RUN_TAG>/
#GYM_VENV_ROOT=                             # empty = `uv run` inside 3rdparty/Gym; a path = the prebuilt venv root
#                                           #   of scripts/build_gym_venvs.sh (it must equal the build path: uv venvs
#                                           #   are not relocatable)
#MILES_TORCH_DIST_DIR=$REPO/models/torch_dist_v5   # the policy's torch_dist twin (default $MILES_AGENT_MODELS/torch_dist_v5)
#MILES_DATA_DIR=                            # the rows of one run (default $MILES_AGENT_DATA/runs/$RUN_TAG)
#MILES_ROOT=$REPO/3rdparty/miles            # the miles checkout the drivers import (default: /root/miles inside the
#                                           #   image when that dir exists, else the submodule)
#MEGATRON_PATH=                             # the Megatron-LM checkout miles trains with (default: the image's copy;
#                                           #   set it on a bare machine)
#MILES_SRC=$REPO/3rdparty/miles             # the miles checkout scripts/check_patches.sh verifies and patches (default:
#                                           #   the submodule; its .git must exist)
#
# ---- policy and teacher ------------------------------------------------------------------------------------
#POLICY_MODEL=Qwen3.5-4B                    # a model dir name under $MILES_AGENT_MODELS
#POLICY_HF=                                 # the policy's HF dir when it is not $MILES_AGENT_MODELS/$POLICY_MODEL
#TEACHER_MODEL=                             # OPD teacher (the *_teacher topologies): a model dir name under $MILES_AGENT_MODELS
#TEACHER_HF=                                # ... or its HF dir
#TEACHER_URL=                               # ... or an already serving teacher (no node of the run serves one then)
#
# ---- environments ------------------------------------------------------------------------------------------
#ALFWORLD_DATA=$REPO/data/alfworld          # the ALFWorld game files (json_2.1.1 under it); default $MILES_AGENT_DATA/alfworld
#WEBSHOP_HOME=$REPO/data/webshop            # the WebShop runtime env_servers/webshop/setup.sh builds; default $MILES_AGENT_DATA/webshop
#WEBSHOP_SERVER_PORT=6200                   # the WebShop engine's loopback port
#WEBSHOP_GOALS_DIGEST=455c9eaa96191605      # the goal-set digest a regenerated webshop_goals.jsonl must reproduce
#WEBSHOP_GOALS_FILE=                        # the goals file scripts/fetch_data.sh webshop --regenerate-goals rewrites (default $REPO/recipes/webshop/data/webshop_goals.jsonl)
#WEBSHOP_MD5_TABLE=                         # the `<name> <md5 or prefix>` table fetch_data.sh webshop --from checks (default $REPO/env_servers/webshop/data_md5.txt)
#WEBSHOP_ENGINE_BASE_URL=                   # the engine URL the recipe and --regenerate-goals talk to (default http://127.0.0.1:<WEBSHOP_SERVER_PORT>)
#SCIENCEWORLD_JAR=                          # the ScienceWorld simulator jar (empty = the wheel's own jar)
#JAVA_HOME=                                 # the JDK the ScienceWorld worker JVMs run on (empty = the java on PATH)
#SCIENCEWORLD_ENV_WORKERS=128               # worker JVMs = concurrent ScienceWorld episodes; lower it on a small machine
#SCIENCEWORLD_TEST_LIST=                    # the eval list scripts/fetch_data.sh scienceworld --from <test.jsonl> | --synthesize writes (default $MILES_AGENT_DATA/scienceworld/scienceworld_test1308.jsonl)
#SCIENCEWORLD_TEST_SHA256=                  # the sha256 a --from re-serialisation must reproduce (default the paper's list; another campaign file pins its own)
#WIKI_SEARCH_DATA=$REPO/data/wiki_search    # the search_r1 rows (scripts/fetch_data.sh search_r1); default $MILES_AGENT_DATA/wiki_search
#RETRIEVER_URL=                             # search_r1: a FlashRAG-compatible retriever, e.g. http://127.0.0.1:8000
#
# ---- services and ports ------------------------------------------------------------------------------------
#NEMO_GYM_URL=                              # set = an external agent server (comma-separated for several); the run starts no gym
#NEMO_GYM_PORT=8200                         # the agent server port of the gym a run starts itself
#PROJECT_PORTS="6100 6200 6379 7100-7131 7200 8100 8200 8265 13141-13143"   # the fixed ports a run pre-checks (8265 cannot move)
#
# ---- venv build (scripts/build_gym_venvs.sh) ---------------------------------------------------------------
#BUILD_DIR=                                 # scratch for the uv cache and the bootstrap uv (default: the venv root itself)
#GYM_TAR=                                   # set = the built root is packaged as $GYM_TAR.partial (a wrapper renames it into place)
#
# ---- Harbor (the coding / terminal recipes: scripts/harbor_trial_server.sh, scripts/harbor_run.sh) ------------
#HARBOR_ENVIRONMENT_IMPORT_PATH=            # the sandbox backend, Harbor's environment.import_path (empty = Harbor's docker environment)
#HARBOR_PACK_ROOT=$HOME/.cache/miles-harness   # where the harness packs are installed
#HARBOR_DATASET=                            # the Harbor dataset: <name>@<version>, <org>/<name>[@<ref>] or /a/dir of task dirs
#HARBOR_PROVIDER=                           # a sandbox backend's provider yaml (the scripts' --provider; unset = Harbor's docker environment)
#HARBOR_ENVIRONMENT_KWARGS=                 # another backend's kwargs, a JSON object
#HARBOR_HARNESS=mini-swe-agent              # the trial server's harness (miles_harbor.harnesses; HARBOR_AGENT is the old name)
#HARBOR_AGENT_KWARGS=                       # the harness's / agent's kwargs, a JSON object
#HARBOR_MAX_CONCURRENT=128                  # trials at once in the trial server
#HARBOR_AGENT_NETWORK=endpoint              # endpoint: the agent reaches its model endpoint alone; task: the task's own network
#HARBOR_REWARD_REQUIRES_SUBMIT=0            # 1 = a run that did not submit scores 0, its tests not run
#HARBOR_RECORDS=                            # the trial server's records (default $MILES_AGENT_RESULTS/<RUN_TAG>/harbor_trials.jsonl)
#HARBOR_WORK_DIR=                           # the trial server's / the run's working dir (defaults: $MILES_AGENT_RESULTS/<RUN_TAG>/trial_server, <out>/work)
#HARBOR_PYTHON=                             # the interpreter with harbor and miles_harbor installed (default $PYTHON)
#HARBOR_BIN=harbor                          # the `harbor` command scripts/harbor_run.sh runs
#TRIAL_SERVER_VENV=                         # a launcher's venv for scripts/harbor_trial_server.sh --config (its bin/python wins over HARBOR_PYTHON)
#TRIAL_SERVER_MODULE=miles_harbor.trial_server   # the trial server module
# OpenSandbox as the backend: HARBOR_ENVIRONMENT_IMPORT_PATH=miles_harbor.opensandbox_env:OpenSandboxEnvironment
#OPENSANDBOX_ENDPOINT=                      # the OpenSandbox server, an https URL (Harbor's OPENSANDBOX_DOMAIN too)
#OPENSANDBOX_CA_FILE=                       # a PEM trusted for that server besides the usual CAs (a self-signed server)
#OPENSANDBOX_PROXY=                         # the HTTP proxy to reach it through (the SDK ignores HTTPS_PROXY)
#
# ---- serving and export ------------------------------------------------------------------------------------
#SERVE_REQUIRE_TOOL_CALL=0                  # 1 = scripts/serve_model.sh refuses (exit 3) a model whose preflight reports NO_TOOL_CALL
#HF_MODEL_ARGS=qwen3.5-4B                   # scripts/export_hf.sh: the model-args script under $MILES_ROOT/scripts/models/
#HF_MODEL_NAME=qwen3_5                      # scripts/export_hf.sh: the converter's model family name
#
# ---- tracking and tokens (prefer exporting secrets from your shell) ----------------------------------------
#WANDB_ENABLE=0                             # 1 = log to wandb (needs WANDB_API_KEY)
#WANDB_API_KEY=
#WANDB_ENTITY=
#HF_TOKEN=
#OPENSANDBOX_KEY=                           # the OpenSandbox server's API key (Harbor's OPENSANDBOX_API_KEY too)
#
# ---- run-level knobs (listed so that one file documents every name) ----------------------------------------
#RECIPE=                                    # run-level: normally a scripts/run_local.sh flag; required, no default (alfworld | scienceworld | webshop | search_r1)
#TOPOLOGY=colocated_1n                      # run-level: normally a scripts/run_local.sh flag
#RUN_TAG=                                   # run-level: normally a scripts/run_local.sh flag
#RUN_SCRIPT=run.py                          # run-level: normally a scripts/run_local.sh flag (eval_full.py, opd.py, ...)
#PROMPT=                                    # run-level: normally a scripts/run_local.sh flag (prompts/<recipe>/<name>.py)
#EXTRA_ARGS=                                # run-level: normally a scripts/run_local.sh flag (extra driver flags, e.g. "--num-rollout 2")
#MODE=                                      # run-level: normally a scripts/run_local.sh flag (debug_rollout_only | r2s_pipeline)
#
# ---- tool overrides (default = the bare name on PATH) ------------------------------------------------------
#PYTHON=python3
#RAY_BIN=ray
#GYM_BIN=gym
#UV_BIN=uv
#CURL=curl
#NVIDIA_SMI=nvidia-smi
#SSH=ssh
#GIT=git                                    # scripts/check_patches.sh
